# Chirp - Class Assignment Bot Environment Configuration

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true
TIMEZONE=Africa/Lagos

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET_KEY=change-me-to-a-super-secret-random-key-in-production
ADMIN_API_KEY=chirp-admin-secret-key-change-in-production

# WhatsApp Gateway Connection
WHATSAPP_GATEWAY_URL=http://localhost:3000
WHATSAPP_GATEWAY_SECRET=chirp-shared-gateway-secret-key-12345
GATEWAY_PORT=3000

# WhatsApp Group & Admin Config
CLASS_GROUP_JID=120363028392039203@g.us
# Comma-separated list of admin phone numbers or WhatsApp JIDs (e.g. 2348012345678@s.whatsapp.net,2348123456789)
INITIAL_ADMIN_JIDS=2348000000000@s.whatsapp.net

# Database Configuration (PostgreSQL in production; SQLite supported for local testing)
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/chirp_db
# Example SQLite: sqlite+aiosqlite:///./chirp.db
DATABASE_URL=sqlite+aiosqlite:///./chirp.db

# Storage Provider (local or supabase)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# Supabase Storage (required if STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=chirp-attachments

# AI Provider Configuration (gemini, openai, or mock)
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-1.5-flash

# Notification & Reminder Scheduling
DEFAULT_REMINDER_HOURS=24
WEEKLY_DIGEST_DAY=sunday
WEEKLY_DIGEST_TIME=17:00
SCHEDULER_INTERVAL_SECONDS=60
